{
  "name": "autocodex-guard",
  "version": "0.4.0",
  "private": true,
  "description": "Local Codex recovery supervisor and monitoring panel",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "demo": "node src/main.mjs --demo",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke:codex": "node scripts/codex-smoke.mjs",
    "diagnose:codex": "node src/main.mjs --diagnose-codex",
    "smoke:faults": "node scripts/codex-fault-smoke.mjs",
    "smoke:dnd": "node scripts/dnd-codex-smoke.mjs",
    "smoke:recycle": "node scripts/recycle-smoke.mjs",
    "smoke:ui-dnd": "node scripts/ui-dnd-smoke.mjs",
    "package": "node scripts/package-plugin.mjs"
  }
}
